{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "NovaLiteOnly",
   "Effect": "Allow",
   "Action": [
    "bedrock:InvokeModel",
    "bedrock:InvokeModelWithResponseStream"
   ],
   "Resource": [
    "arn:aws:bedrock:ap-south-1:${ACCOUNT_ID}:inference-profile/apac.amazon.nova-lite-v1:0",
    "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0"
   ]
  },
  {
   "Sid": "CoachMemoryOnly",
   "Effect": "Allow",
   "Action": [
    "bedrock-agentcore:CreateEvent",
    "bedrock-agentcore:ListEvents",
    "bedrock-agentcore:GetEvent",
    "bedrock-agentcore:RetrieveMemoryRecords",
    "bedrock-agentcore:ListMemoryRecords"
   ],
   "Resource": "arn:aws:bedrock-agentcore:ap-south-1:${ACCOUNT_ID}:memory/skillup_coach_memory-${MEMORY_SUFFIX}"
  },
  {
   "Sid": "Logs",
   "Effect": "Allow",
   "Action": [
    "logs:CreateLogGroup",
    "logs:CreateLogStream",
    "logs:PutLogEvents",
    "logs:DescribeLogStreams",
    "logs:DescribeLogGroups"
   ],
   "Resource": "arn:aws:logs:ap-south-1:${ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/runtimes/*"
  },
  {
   "Sid": "Traces",
   "Effect": "Allow",
   "Action": [
    "xray:PutTraceSegments",
    "xray:PutTelemetryRecords",
    "xray:GetSamplingRules",
    "xray:GetSamplingTargets"
   ],
   "Resource": "*"
  },
  {
   "Sid": "Metrics",
   "Effect": "Allow",
   "Action": "cloudwatch:PutMetricData",
   "Resource": "*",
   "Condition": {
    "StringEquals": {
     "cloudwatch:namespace": "bedrock-agentcore"
    }
   }
  },
  {
   "Sid": "WorkloadIdentity",
   "Effect": "Allow",
   "Action": [
    "bedrock-agentcore:GetWorkloadAccessToken",
    "bedrock-agentcore:GetWorkloadAccessTokenForJWT",
    "bedrock-agentcore:GetWorkloadAccessTokenForUserId"
   ],
   "Resource": [
    "arn:aws:bedrock-agentcore:ap-south-1:${ACCOUNT_ID}:workload-identity-directory/default",
    "arn:aws:bedrock-agentcore:ap-south-1:${ACCOUNT_ID}:workload-identity-directory/default/workload-identity/*"
   ]
  },
  {
   "Sid": "CodePackage",
   "Effect": "Allow",
   "Action": "s3:GetObject",
   "Resource": "arn:aws:s3:::bedrock-agentcore-code-${ACCOUNT_ID}-ap-south-1/skillup_coach_agent/*"
  },
  {
   "Sid": "SpansToOwnLogGroup",
   "Effect": "Allow",
   "Action": "logs:PutResourcePolicy",
   "Resource": "arn:aws:logs:ap-south-1:${ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/runtimes/*"
  }
 ]
}